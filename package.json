{
  "name": "vibetrack",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "check:services": "npm run check:services -w backend",
    "check:secrets": "node scripts/check-secrets.cjs",
    "pretest": "npm run check:secrets"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
