PORT=3000
# En producción se escucha en 0.0.0.0 automáticamente; en desarrollo, en 127.0.0.1.
# HOST=0.0.0.0
# Solo detrás de un proxy conocido; Render usa el valor definido en render.yaml.
TRUST_PROXY_HOPS=0
# En producción debe ser la URL HTTPS pública. En Render se puede usar RENDER_EXTERNAL_URL.
FRONTEND_ORIGIN=http://localhost:5173
# Opcional en esta fase: la búsqueda musical no necesita base de datos.
MONGODB_URI=
# Las recomendaciones por mood requieren esta clave. Nunca usar VITE_ para secretos.
LASTFM_API_KEY=
# Secreto aleatorio de al menos 32 caracteres para firmar las sesiones JWT.
JWT_SECRET=
# Deezer (previews y búsqueda) y ReccoBeats (rasgos de audio) no requieren clave.
# Pon false para clasificar el mood sólo con etiquetas de Last.fm.
RECCOBEATS_ENABLED=true
# Tono de la letra (LRCLIB + diccionario local, sin clave). Pon false para ignorar las letras.
LYRICS_ENABLED=true
# Spotify (opcional): reproducción completa con Premium y gustos importados.
# Crea una app en https://developer.spotify.com/dashboard, añade este Redirect URI exacto
# (Spotify exige 127.0.0.1, no localhost) y, en modo desarrollo, a cada usuario en "User Management".
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/api/spotify/callback
# Opcional: clave de 32 bytes en base64 para cifrar los tokens (si falta se deriva de JWT_SECRET).
SPOTIFY_TOKEN_KEY=
