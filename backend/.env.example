PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# Opcional en esta fase: la búsqueda musical no necesita base de datos.
MONGODB_URI=
# Las recomendaciones por mood requieren esta clave. Nunca usar VITE_ para secretos.
LASTFM_API_KEY=
# Secreto aleatorio de al menos 32 caracteres para firmar las sesiones JWT.
JWT_SECRET=
# Deezer (previews y búsqueda) y ReccoBeats (rasgos de audio) no requieren clave.
# Pon false para clasificar el mood sólo con etiquetas de Last.fm.
RECCOBEATS_ENABLED=true
